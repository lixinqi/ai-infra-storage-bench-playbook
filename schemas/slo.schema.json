{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-bench-playbook/schemas/slo.schema.json",
  "title": "SLOConfig",
  "description": "部署时提供的 SLO 配置：只覆盖重保子集，阈值与出处由使用方填写。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "owner",
    "selector",
    "slos"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "recipe": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "workload": {
          "type": "string",
          "enum": [
            "checkpoint",
            "dataset",
            "kvcache"
          ]
        },
        "model_family": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage_backend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage_adapter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "comparator",
          "target",
          "unit",
          "provenance",
          "valid_for",
          "review_due"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "comparator": {
            "type": "string",
            "enum": [
              "<=",
              ">="
            ]
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "date"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "requirement",
                  "baseline",
                  "ceiling"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "valid_for": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backend": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "adapter": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "topology": {
                "type": "string"
              }
            }
          },
          "review_due": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
