{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-bench-playbook/schemas/metrics.schema.json",
  "title": "RecipeMetrics",
  "description": "某个配方选用的指标、参数与阈值。对应 recipes/<name>/metrics.yaml。阈值只在这里声明，check 脚本通过 --metrics 读取同一份文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe", "metrics"],
  "properties": {
    "recipe": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "gate", "tolerance"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "gate": { "type": "string", "pattern": "^G[0-9]+[a-z]?$" },
          "items": {
            "description": "本配方判定哪些度量项。留空时以 tolerance 的键为准。",
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "tolerance": {
            "description": "键必须是 check 支持的度量项名；值可以是小数（0.08 表示 8%）或百分号字符串（\"8%\"）。",
            "type": "object",
            "additionalProperties": { "type": ["number", "string"] },
            "minProperties": 1
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
