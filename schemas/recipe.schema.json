{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/ai-infra-storage-bench-playbook/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "一个评估集配方的元信息。对应 recipes/<name>/recipe.yaml。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "status",
    "owner",
    "type",
    "bypass",
    "fidelity_boundary",
    "io_pattern_invariants",
    "scaling_plan",
    "metrics_ref",
    "compatible_metrics",
    "acceptance"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "评估集类别。当前为 model-code-collection / checkpoint-dataset / kvcache，允许扩展。"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "bypass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "method",
        "kept"
      ],
      "properties": {
        "what": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "meta-device",
            "module-mock",
            "cpu-offload",
            "real-small-scale",
            "mixed"
          ]
        },
        "kept": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "fidelity_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bypassed",
          "method",
          "fidelity",
          "kept",
          "known_bias"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bypassed": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "partial"
            ]
          },
          "method": {
            "type": "string"
          },
          "fidelity": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "na"
            ]
          },
          "kept": {
            "type": "string",
            "minLength": 1
          },
          "known_bias": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "io_pattern_invariants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "definition",
          "tolerance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "tolerance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scaling_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "fixed_dimensions",
        "varied_dimension"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scale",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "scale": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fixed_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "varied_dimension": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics_ref": {
      "type": "string",
      "pattern": "^[.]/metrics[.]yaml$"
    },
    "compatible_metrics": {
      "description": "每个指标兼容的版本。键是指标名，值是版本列表。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "uniqueItems": true
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklist",
        "gates"
      ],
      "properties": {
        "checklist": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^G[0-9]+[a-z]?$"
          },
          "uniqueItems": true
        }
      }
    },
    "latest_run": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "run_id",
        "report_uri",
        "metrics_uri",
        "sha256",
        "status",
        "finished_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "report_uri": {
          "type": "string",
          "minLength": 1
        },
        "metrics_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "deprecated_reason": {
      "type": "string"
    },
    "replaced_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
