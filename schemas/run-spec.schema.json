{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-infra-storage-bench-playbook/schemas/run-spec.schema.json",
  "title": "RunSpec",
  "description": "提交给评估服务的一次运行请求。字段定义见 playbook/evaluation-service.md 的「运行请求」。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe",
    "recipe_version",
    "model",
    "level",
    "topology",
    "load",
    "observe",
    "seed",
    "storage"
  ],
  "properties": {
    "recipe": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "recipe_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "commit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "framework": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "推理框架名。当前为 vllm / sglang / deepinfer，允许扩展。"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "gpus_per_node",
        "network",
        "mount"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "gpus_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "mount": {
          "type": "string",
          "minLength": 1,
          "description": "存储挂载方式，例如 local-nvme、nfs、fuse。"
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "duration_s"
      ],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "input_len": {
          "type": "integer",
          "minimum": 1
        },
        "output_len": {
          "type": "integer",
          "minimum": 1
        },
        "arrival_interval_ms": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sample_rate",
        "layers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "app",
              "sys",
              "storage"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "level": {
      "type": "string",
      "pattern": "^S[0-9]+$",
      "description": "规模档位，对应配方 scaling_plan.levels[].id。"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "adapter"
      ],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "version": {
              "type": "string"
            },
            "config_ref": {
              "type": "string"
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "version": {
              "type": "string"
            },
            "config_ref": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
